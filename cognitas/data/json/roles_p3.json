  "recommended_flags": {
    "arcana": "bool (Identifies the player as a Social Link/Arcana. Used for Nyx's apocalypse progression)",
    "sees": "bool (Identifies the player as a SEES member, triggering Fuuka's radar)",
    "investigation_override": "str (Text returned if an investigative role examines this player)",
    "hidden_vote": "bool (Masks the player's name in public daytime votes)",
    "awakened": "bool (Generic global flag indicating if a SEES member has their full abilities)",
    "makoto_awakened": "bool (Automatically injects Wild Resonance, Luz de los Vinculos and The Final Seal)",
    "fuuka_awakened": "bool (Automatically injects Sensores, Registro and Oracle Scan)",
    "akihiko_awakened": "bool (Automatically injects Punos, Instinto and Sonic Counter)",
    "yukari_awakened": "bool (Automatically injects Viento, Luz Sanadora and Hymn of Salvation)",
    "junpei_awakened": "bool (Automatically injects Ataque Temerario, De las Cenizas and Heroic Strike)",
    "aigis_awakened": "bool (Automatically injects Modo Guardia, Protocolo Defensivo and Orgia Mode)",
    "ken_awakened": "bool (Automatically injects Lanza del Castigo, Justicia Retrograda and Final Justice)",
    "koromaru_awakened": "bool (Automatically injects Olfato, Instinto and Lunar Scent)",
    "nyx_phase_one": "bool (Injects Corrupcion Lunar and warns of Umbra effect [1 dead Arcana])",
